  "mc_settings_emote_size_desc": "Multiplier ng resolution para sa emotes sa chat. 1x malinaw at compact, 2x sweet spot para sa karamihan ng monitor, 4x para sa gusto makita kada pixel.",
  "mc_settings_input_preview_desc": "Pinapakita ang emotes bilang larawan diretso sa input box habang nagta-type ka, sa halip na text names. Ang nakikita mo ang ipinapadala mo.",
  "mc_settings_clickable_links_desc": "Ginagawang clickable ang URLs sa chat messages. I-off kung mas gusto mo ang copy-paste o hindi mo pinagkakatiwalaan ang mga estranghero sa internet.",
  "mc_settings_vi_mode_desc": "Vim-style shortcuts para sa chat navigation. j/k scroll, g/G top/bottom, / hanapin. Para sa nagiisip na ang mouse ay para sa casuals.",
  "mc_settings_zebra_desc": "Salit-salit na shading sa chat messages. Mas madaling sundan ang mahabang messages, lalo na sa mabilis na chat.",
  "mc_settings_auto_hide_desc": "Itinatago ang input bar kapag hindi ka nag-aakto. I-click o magsimula mag-type para ibalik. Pina-maximize ang chat viewing space.",
  "mc_settings_timestamps_desc": "Ipinapakita ang oras ng pagpapadala bawat message sa tabi ng username. Mainam para malaman kung anong nangyari habang AFK ka.",
  "mc_settings_avatars_desc": "Ipinapakita ang profile pictures sa tabi ng username sa chat. Mas madaling makilala ang regulars, kapalit ng kaunting vertical space.",
  "mc_settings_inline_notifs": "inline notifications",
  "mc_settings_notif_op": "[OP] orihinal posts",
  "mc_settings_notif_op_reply": "[OP] OP nagre-reply sa sariling thread",
  "mc_settings_notif_re": "[RE] mga reply",
  "mc_settings_notif_dm": "[DM] whispers at DMs",
  "mc_settings_notif_op_desc": "Notification sa active chat tab kapag may gumawa ng bagong post sa feed.",
  "mc_settings_notif_op_reply_desc": "Notification kapag ang orihinal poster ay nagre-reply sa sariling thread.",
  "mc_settings_notif_re_desc": "Notification para sa bawat reply sa kahit anong thread sa feed.",
  "mc_settings_notif_dm_desc": "Notification kapag may natanggap kang whisper o DM.",
  "mc_settings_twitch_events": "Twitch events",
  "mc_settings_raids": "raids",
  "mc_settings_raids_desc": "Inline banner kapag may streamer na nag-raid papasok o palabas, kasama ang viewer count at pinanggalingang channel. Pwede kang sumakay sa next stream.",
  "mc_settings_hype_trains": "hype trains",
  "mc_settings_hype_trains_desc": "Live progress banner para sa hype trains, ipinapakita ang level at contribution timer. Default off kasi palaging nag-fi-fire sa malalaking channel.",
  "mc_settings_gift_subs": "gift subs",
  "mc_settings_gift_subs_desc": "Banner para sa community gift sub bombs at individual gifts, kasama ang gifter, recipient at tier.",
  "mc_settings_redeems": "channel point redeems",
  "mc_settings_redeems_desc": "Inline notice para sa channel point redemptions tulad ng 'highlight my message' para makita mo kung saan ginagamit ng mga tao ang puntos.",
  "mc_settings_prediction_banner": "predictions",
  "mc_settings_prediction_banner_desc": "Live banner ng channel point prediction na may current odds at oras na natitira para mag-lock-in ng vote.",
  "mc_settings_poll_banner": "polls",
  "mc_settings_poll_banner_desc": "Active poll banner na may vote tallies at oras na natitira. Mag-vote diretso mula sa overlay.",
  "mc_settings_pinned_messages": "pinned messages",
  "mc_settings_pinned_messages_desc": "Sticky banner para sa moderator-pinned chat messages para hindi mo ma-miss ang rules o schedule.",
  "mc_settings_dim_timeouts": "i-dim ang timed-out messages",
  "mc_settings_dim_timeouts_desc": "Ipakita ang timed-out at banned messages sa 50% opacity sa halip na itago, FFZ/BTTV style. Makikita mo kung anong na-nuke nang hindi umalis sa chat.",
  "mc_settings_smart_completion": "smart tab completion",
  "mc_settings_smart_completion_desc": "Recent chatters at emotes sa channel na ito ay lumalabas muna sa tab-completing. Mas mabilis kaysa sa alphabetical kapag mabilis ang chat.",
  "mc_settings_first_chatter": "first-message glow",
  "mc_settings_first_chatter_desc": "Orange edge marker sa first message ng user sa bawat channel sa session na ito. Madali makita ang mga bago dating sa mabilis na chat.",
  "mc_settings_keyword_highlights": "keyword highlights",
  "mc_settings_keyword_highlights_desc": "Mga messages na may kahit anong salita rito ay nagiging orange, parang personal mention. Hiwa-hiwalay ng linya, hindi case-sensitive, whole-word matches.",
  "mc_settings_keyword_highlights_placeholder": "isang keyword bawat linya",
  "mc_settings_features": "features",
  "mc_settings_auto_claim": "auto-claim ng channel points",
  "mc_settings_auto_claim_desc": "Automatic na ki-click ang bonus channel points chest sa Twitch kapag lumitaw. Libreng puntos, walang effort.",
