{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "default_locale": "en",
  "name": "__MSG_manifest_name__",
  "short_name": "heatsync",
  "version": "1.7.6",
  "description": "__MSG_manifest_description__",
  "author": "heatsync.org",
  "homepage_url": "https://heatsync.org",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "cookies",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://static-cdn.jtvnw.net/*",
    "https://heatsync.org/*",
    "https://*.twitch.tv/*",
    "https://api.twitch.tv/*",
    "https://kick.com/*",
    "https://*.kick.com/*",
    "https://www.youtube.com/*",
    "https://api.betterttv.net/*",
    "https://api.frankerfacez.com/*",
    "https://7tv.io/*",
    "https://events.7tv.io/*",
    "https://cdn.betterttv.net/*",
    "https://cdn.7tv.app/*",
    "https://api.7tv.app/*",
    "https://recent-messages.robotty.de/api/v2/recent-messages/*",
    "https://logs.ivr.fi/*",
    "https://logs.zonian.dev/*",
    "https://logs.spanix.team/*",
    "https://decapi.me/*",
    "https://api.chatterino.com/badges"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "js": [
        "early-inject-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://kick.com/*",
        "https://*.kick.com/*"
      ],
      "js": [
        "kick-nav-watcher.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-keyboard-guard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.twitch.tv/*",
        "https://kick.com/*",
        "https://*.kick.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "early-layout.js",
        "pcard-early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "js": [
        "emoji-data.js",
        "autocomplete-hook.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://kick.com/*",
        "https://*.kick.com/*"
      ],
      "js": [
        "kick-autocomplete-hook.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.twitch.tv/*",
        "https://kick.com/*",
        "https://*.kick.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "vi-mode.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.twitch.tv/*",
        "https://kick.com/*",
        "https://*.kick.com/*",
        "https://heatsync.org/*"
      ],
      "js": [
        "emoji-data.js",
        "shared-utils.js",
        "platform-detector.js",
        "chat-injector.js",
        "content.js"
      ],
      "css": [
        "injected-message.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.twitch.tv/*",
        "https://kick.com/*",
        "https://*.kick.com/*"
      ],
      "js": [
        "heatsync-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.twitch.tv/*",
        "https://kick.com/*",
        "https://*.kick.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "emoji-data.js",
        "shared-utils.js",
        "multichat.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "js": [
        "emoji-data.js",
        "shared-utils.js",
        "platform-detector.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "js": [
        "heatsync-button.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "js": [
        "youtube-content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png"
    },
    "default_title": "heatsync"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon-16.png",
        "icon-48.png",
        "icon-48-black.png"
      ],
      "matches": [
        "https://*.twitch.tv/*",
        "https://kick.com/*",
        "https://*.kick.com/*",
        "https://www.youtube.com/*",
        "https://heatsync.org/*"
      ]
    },
    {
      "resources": [
        "_locales/*/messages.json"
      ],
      "matches": [
        "https://*.twitch.tv/*",
        "https://kick.com/*",
        "https://*.kick.com/*",
        "https://www.youtube.com/*"
      ]
    },
    {
      "resources": [
        "fonts/CozetteVector.woff2",
        "fonts/GohuFont-14.woff2"
      ],
      "matches": [
        "https://*.twitch.tv/*",
        "https://kick.com/*",
        "https://*.kick.com/*",
        "https://www.youtube.com/*"
      ]
    }
  ]
}
