{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": {
          "level": "off",
          "options": {
            "allow": [
              "log"
            ]
          }
        },
        "noControlCharactersInRegex": "off",
        "noMisleadingCharacterClass": "off",
        "noDoubleEquals": "warn",
        "useIterableCallbackReturn": "warn",
        "noAssignInExpressions": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn",
        "noInnerDeclarations": "off"
      },
      "style": {
        "useConst": "off"
      }
    }
  },
  "files": {
    "includes": [
      "src/**/*.js",
      "chrome/**/*.js",
      "tests/**/*.js",
      "tools/**/*.js",
      "build.js",
      "!dist",
      "!node_modules",
      "!chrome/emoji-data.js",
      "!chrome/emoji-data.iso.js"
    ]
  },
  "overrides": [
    {
      "includes": [
        "src/lib/paint-core.js",
        "src/lib/scene-spec.js",
        "src/lib/paint-spec.js"
      ],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    }
  ]
}
