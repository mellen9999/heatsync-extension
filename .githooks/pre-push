#!/usr/bin/env bash
# pre-push gate — catches the exact drift that silently reddened CI (lint/tsc/version).
# fast checks only (no smoke — that's release.yml's job + hangs headless). bypass: git push --no-verify
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"

fail=0
run() { printf '  %-12s' "$1"; if eval "$2" >/dev/null 2>&1; then echo "ok"; else echo "FAIL"; fail=1; fi; }

echo "pre-push gate:"
run lint      "bunx @biomejs/biome check src/ tests/ build.js && bunx @biomejs/biome check tests/ --error-on-warnings"
run typecheck "bun run typecheck"
run version   "bun tests/check-versions.js"
run bundle    "bun run build.js chrome --minify && bun run build.js firefox --minify && bun scripts/check-bundle-budget.ts"
# what chrome/ still tracks (manifest, _locales) is built from src: a src edit pushed without
# its rebuild reddened ci once (a merged pr that added strings). status, not diff: a
# rebuild that is staged but not committed, or a new file nobody added, is still not pushed
run tracked   'test -z "$(git status --porcelain -- chrome/)"'
run crashclass "node scripts/type-signal.mjs"
run test      "bun test --coverage --coverage-reporter=lcov"
run coverage  "bun scripts/coverage-floor.ts"

# ci on main sat red for 24 commits once: every push landed on top and nobody looked.
# Not a block (the push may be the fix), only said out loud.
if command -v gh >/dev/null 2>&1; then
  last="$(timeout 8 gh run list --workflow ci --branch main --status completed --limit 1 \
    --json conclusion,headSha -q '.[0] | "\(.conclusion) \(.headSha[0:8])"' 2>/dev/null || true)"
  case "$last" in
    failure*) echo "  !! ci on main is RED at ${last#failure } — fix that before stacking more on it" ;;
  esac
fi

if [ "$fail" -ne 0 ]; then
  echo "push blocked — fix above (or 'git push --no-verify' to override)."
  exit 1
fi
echo "all green — pushing."
